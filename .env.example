# Copy to .env for local development. Never commit .env.

CORTEX_ENV=local

# Postgres
CORTEX_POSTGRES_DSN=postgresql+asyncpg://cortex:cortex@localhost:5433/cortex

# FalkorDB (knowledge graph, one named graph per tenant)
CORTEX_FALKORDB_HOST=localhost
CORTEX_FALKORDB_PORT=6381
CORTEX_FALKORDB_PASSWORD=

# Qdrant (one collection per tenant)
CORTEX_QDRANT_URL=http://localhost:6333
CORTEX_QDRANT_API_KEY=

# Redis (Celery broker + result backend)
CORTEX_REDIS_URL=redis://localhost:6380/0

# Credential vault master key.
# Generate with: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CORTEX_VAULT_MASTER_KEY=

# LLM providers (multi-provider from day one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Slack entry point (optional) -------------------------------------------
# The Slack app's signing secret. Without it the /slack/events endpoint refuses every
# request: verification fails closed rather than checking an internet-facing webhook
# against an empty key.
CORTEX_SLACK_SIGNING_SECRET=

# Public base URL, used only for the "full report" link in a delivered Slack message.
# Unset means no link rather than a localhost one.
CORTEX_PUBLIC_BASE_URL=
